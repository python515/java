public class Pyramid {
    public static void main(String[] args) {
        int height = 5; // change this to any number

        for (int i = 1; i <= height; i++) {
            // spaces
            for (int s = 1; s <= height - i; s++) {
                System.out.print(" ");
            }
            // stars
            for (int j = 1; j <= 2 * i - 1; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
